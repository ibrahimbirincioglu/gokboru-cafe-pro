# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://gokboru:gokboru@localhost:5432/gokboru_cafe?schema=public"

# Public application URL. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# At least 32 random characters. Used only to HMAC identifiers stored by
# login throttling and request metadata; never expose it to the browser.
AUTH_HASH_SECRET="replace-with-at-least-32-random-characters"

# Optional and development-only. If set, `prisma db seed` creates OWNER,
# ADMIN, CASHIER and WAITER users. Supply an Argon2id hash, never plaintext.
DEV_SEED_PASSWORD_HASH=""
