generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Table {
  id          String   @id @default(cuid())
  number      Int      @unique
  name        String
  isActive    Boolean  @default(true)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
